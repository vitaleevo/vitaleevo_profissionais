<% if controller_name != "sessions" %>
  <%= link_to "Entrar", new_session_path(resource_name), class: "text-link" %>
<% end %>

<% if devise_mapping.registerable? && controller_name != "registrations" %>
  <%= link_to "Criar conta", new_registration_path(resource_name), class: "text-link" %>
<% end %>

<% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
  <%= link_to "Esqueci a senha", new_password_path(resource_name), class: "text-link" %>
<% end %>
