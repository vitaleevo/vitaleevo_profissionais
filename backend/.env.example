# Cópia para .env — nunca commitar segredos reais.
DJANGO_ENV=development
SECRET_KEY=dev-only-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção (Railway preenche automaticamente):
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# REDIS_URL=redis://default:pass@host:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vitaleevo.ao,https://www.vitaleevo.ao

# E-mail (opcional em dev; obrigatório em produção)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@vitaleevo.ao

SITE_URL=https://vitaleevo.ao