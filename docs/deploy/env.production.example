# Copie os valores necessarios para o gestor de secrets do ambiente.
# Nunca use estes placeholders como secrets reais.

# Ambiente base
RAILS_ENV=production
NODE_ENV=production
PROFISSIONAIS_ROOT_DOMAIN=profiangola.ao

# Secrets
RAILS_MASTER_KEY=replace_with_rotated_rails_master_key_from_secret_manager
SECRET_KEY_BASE=replace_with_bin_rails_secret
POSTGRES_PASSWORD=replace_with_strong_database_password

# Banco
POSTGRES_HOST=db
POSTGRES_DATABASE=profissionais_production
POSTGRES_USER=profissionais
POSTGRES_CACHE_DATABASE=profissionais_production_cache
POSTGRES_QUEUE_DATABASE=profissionais_production_queue
POSTGRES_CABLE_DATABASE=profissionais_production_cable

# Rails, hosts e SSL
RAILS_HOSTS=profiangola.ao,www.profiangola.ao,admin.profiangola.ao,operacoes.profiangola.ao,app.profiangola.ao,rails,localhost,127.0.0.1
RAILS_FORCE_SSL=true
RAILS_ASSUME_SSL=true
RAILS_LOG_LEVEL=info
RAILS_MAILER_HOST=profiangola.ao
RAILS_MAILER_PROTOCOL=https
RAILS_ASSET_HOST=
ACTIVE_STORAGE_SERVICE=local
DEVISE_MAILER_SENDER=no-reply@profiangola.ao

# Limites defensivos por IP
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=60
RATE_LIMIT_API_PER_MINUTE=300

# Cookie compartilhado entre os hosts do produto
SESSION_COOKIE_KEY=_profiangola_session
SESSION_COOKIE_DOMAIN=.profiangola.ao
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT_MINUTES=720
DEVISE_REMEMBER_FOR_DAYS=7

# Next.js
FRONTEND_PUBLIC_BASE_URL=https://profiangola.ao
FRONTEND_ALLOWED_HOSTS=profiangola.ao,www.profiangola.ao,admin.profiangola.ao,operacoes.profiangola.ao,app.profiangola.ao
RAILS_API_BASE_URL=http://rails:80
RAILS_PUBLIC_BASE_URL=https://profiangola.ao
NEXT_PUBLIC_RAILS_ASSET_HOSTS=https://profiangola.ao,https://www.profiangola.ao,https://admin.profiangola.ao,https://operacoes.profiangola.ao,https://app.profiangola.ao
PUBLIC_PROFESSIONAL_SEARCH_RATE_LIMIT_PER_MINUTE=60
YANDEX_TRIP_INFO_RATE_LIMIT_PER_MINUTE=30

# Smoke/deploy local
PROFISSIONAIS_SMOKE_SCHEME=https
PROFISSIONAIS_SMOKE_BASE_DOMAIN=profiangola.ao
PROFISSIONAIS_SMOKE_API_BASE_URL=https://profiangola.ao

# Preflight de staging real
PROFISSIONAIS_PREFLIGHT_SCHEME=https
PROFISSIONAIS_PREFLIGHT_BASE_DOMAIN=profiangola.ao
PROFISSIONAIS_PREFLIGHT_API_BASE_URL=https://profiangola.ao
PROFISSIONAIS_PREFLIGHT_EXPECTED_IP=
PROFISSIONAIS_PREFLIGHT_TARGET_IP=
PROFISSIONAIS_PREFLIGHT_MIN_TLS_DAYS=14
PROFISSIONAIS_PREFLIGHT_COOKIE_DOMAIN=.profiangola.ao
PROFISSIONAIS_PREFLIGHT_COOKIE_NAME=_profiangola_session

# Evidencias de staging
PROFISSIONAIS_EVIDENCE_DIR=
PROFISSIONAIS_RUN_INTEGRATED_SMOKE=true
PROFISSIONAIS_RUN_LOCAL_PREFLIGHT=true
PROFISSIONAIS_RUN_REMOTE_CHECKS=false
PROFISSIONAIS_RUN_REMOTE_FRONTEND_SMOKE=false
PROFISSIONAIS_RUN_SCREENSHOTS=false
PROFISSIONAIS_RUN_MANUAL_QA_TEMPLATE=true
PROFISSIONAIS_REQUIRE_MANUAL_QA=false
PROFISSIONAIS_MANUAL_QA_FILE=
PROFISSIONAIS_MANUAL_QA_BASE_URL=
PROFISSIONAIS_MANUAL_QA_TESTER=
PROFISSIONAIS_MANUAL_QA_OVERWRITE=false
PROFISSIONAIS_RELEASE_ID=
PROFISSIONAIS_SCREENSHOT_BASE_URL=
PROFISSIONAIS_SCREENSHOT_OUTPUT_DIR=
PROFISSIONAIS_SCREENSHOT_AUTHENTICATED=true
PROFISSIONAIS_SCREENSHOT_CLIENT_EMAIL=
PROFISSIONAIS_SCREENSHOT_PROFESSIONAL_EMAIL=
PROFISSIONAIS_SCREENSHOT_ADMIN_EMAIL=
PROFISSIONAIS_SCREENSHOT_PASSWORD=
PROFISSIONAIS_FRONTEND_SMOKE_BASE_URL=
PROFISSIONAIS_FRONTEND_SMOKE_API_BASE_URL=
PROFISSIONAIS_FRONTEND_SMOKE_CLIENT_EMAIL=
PROFISSIONAIS_FRONTEND_SMOKE_REVIEW_CLIENT_EMAIL=
PROFISSIONAIS_FRONTEND_SMOKE_PROFESSIONAL_EMAIL=
PROFISSIONAIS_FRONTEND_SMOKE_ADMIN_EMAIL=
PROFISSIONAIS_FRONTEND_SMOKE_PASSWORD=
PROFISSIONAIS_FRONTEND_SMOKE_CURL_TIMEOUT=120

# Backup/restore operacional
PROFISSIONAIS_ENV_FILE=.env.production
PROFISSIONAIS_COMPOSE_FILE=compose.production.example.yaml
PROFISSIONAIS_BACKUP_DIR=backups
PROFISSIONAIS_BACKUP_RETENTION_DAYS=14
PROFISSIONAIS_BACKUP_DATABASE=profissionais_production
PROFISSIONAIS_RESTORE_DATABASE=profissionais_restore_validation
PROFISSIONAIS_STORAGE_SERVICE=rails
PROFISSIONAIS_STORAGE_PATH=/rails/storage
PROFISSIONAIS_STORAGE_BACKUP_IMAGE=postgres:16-alpine
PROFISSIONAIS_STORAGE_DOCKER_VOLUME=
PROFISSIONAIS_STORAGE_RESTORE_CONFIRM=
